<Window x:Class="TV_Шаповалова.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TV_Шаповалова"
        mc:Ignorable="d"
        Title="Телевизор" Height="450" Width="800" MinHeight="450" MinWidth="800" FontFamily="Arial Narrow" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Background="#FF383838">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="NameChannel" Text="Телевизор выключен" VerticalAlignment="Center" Margin="20,0,10,0" Foreground="White" TextTrimming="CharacterEllipsis" Grid.Column="0"/>

        <Label x:Name="Channel" Content="Канал:" VerticalAlignment="Center" Foreground="White" Margin="0,0,5,0" Grid.Column="1"/>
        <TextBox x:Name="numChannel" Background="LightGray" Margin="0,0,5,0" VerticalAlignment="Center" Height="22" Grid.Column="2"/>
        <Button Content="Выбрать" VerticalAlignment="Center" Width="60" Height="25" Background="White" Click="Num_Click" Margin="0,0,20,0" Grid.Column="3"/>
        <Button x:Name="PowerButton" Click="Power_Click" Content="Включить" HorizontalAlignment="Right" VerticalAlignment="Center" Width="100" Height="25" Background="White" Grid.Column="4" Margin="0,0,20,0"/>

        <MediaElement x:Name="VideoPLayer"   LoadedBehavior="Manual" Volume="1" Stretch="UniformToFill" Margin="20,10,20,50" Grid.ColumnSpan="5" Grid.Row="1" Opacity="0"/>

        <Grid Margin="0,0,0,0" Height="50" VerticalAlignment="Bottom" Grid.ColumnSpan="5" Grid.Row="1">
            <Button Click="BackChannel" Content="Назад" HorizontalAlignment="Left" Margin="20,0,0,10" VerticalAlignment="Bottom" Width="100" Height="25" Background="White"/>
            <Button Click="NextChannel" Content="Вперёд" HorizontalAlignment="Left" Margin="125,0,0,10" VerticalAlignment="Bottom" Width="100" Height="25" Background="White"/>
            <Button Click="DownSound_Click" Content="Тише" HorizontalAlignment="Right" Margin="0,0,125,10" VerticalAlignment="Bottom" Width="100" Height="25" Background="White"/>
            <Button Click="UpSound_Click" Content="Громче" HorizontalAlignment="Right" Margin="0,0,20,10" VerticalAlignment="Bottom" Width="100" Height="25" Background="White"/>
        </Grid>
        <TextBlock x:Name="VolumeText" Text="Громкость: 50%" Foreground="White" Grid.Row="0" Grid.Column="4" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,10,140,0"/>
    </Grid>
</Window>